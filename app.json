{
  "expo": {
    "name": "Aron Parti",
    "slug": "aron-parti",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "aronparti",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#08080C",
    "ios": {
      "bundleIdentifier": "com.aronchat.parti",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true,
        "NSMicrophoneUsageDescription": "İzleme partisinde sesli sohbet edebilmen için mikrofon izni gerekiyor. Ses yalnız partidekilere iletilir, kaydedilmez.",
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Profil fotoğrafını çekebilmen için kamera izni gerekiyor. Fotoğraf yalnız senin profilinde kullanılır.",
        "NSPhotoLibraryUsageDescription": "Profil fotoğrafı seçebilmen için fotoğraflarına erişim gerekiyor. Yalnız seçtiğin fotoğraf yüklenir.",
        "NSPhotoLibraryAddUsageDescription": "Parti anlarını galerine kaydedebilmen için izin gerekiyor."
      }
    },
    "android": {
      "package": "com.aronchat.parti",
      "adaptiveIcon": {
        "backgroundColor": "#08080C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.WAKE_LOCK",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.VIBRATE"
      ],
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#08080C",
          "image": "./assets/images/splash.png",
          "resizeMode": "cover",
          "dark": {
            "image": "./assets/images/splash.png",
            "resizeMode": "cover",
            "backgroundColor": "#08080C"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-asset",
      "expo-status-bar",
      "expo-secure-store",
      "expo-localization",
      "expo-sharing",
      "expo-audio",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  }
}
